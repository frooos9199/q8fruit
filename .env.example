# ========================================
# Q8 Fruit - Environment Variables
# ========================================
# Copy this file to .env.local and fill in your actual values

# ========================================
# Firebase Configuration (for both web & mobile)
# ========================================
# احصل على هذه القيم من Firebase Console
# https://console.firebase.google.com

NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# ========================================
# Google Analytics & Tag Manager
# ========================================
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Get these from:
# - Google Analytics: https://analytics.google.com/
# - Google Tag Manager: https://tagmanager.google.com/

# ========================================
# Facebook Pixel
# ========================================
NEXT_PUBLIC_FB_PIXEL_ID=YOUR_FB_PIXEL_ID

# Get from: https://business.facebook.com/events_manager

# ========================================
# Firebase Admin SDK (for notifications)
# ========================================
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Get from:
# 1. Go to Firebase Console: https://console.firebase.google.com/
# 2. Project Settings > Service Accounts
# 3. Generate New Private Key
# 4. Copy the values from the downloaded JSON file

# ========================================
# Site Configuration
# ========================================
NEXT_PUBLIC_SITE_URL=https://www.q8fruit.com

# Use http://localhost:3000 for development

# ========================================
# Email Service (Resend)
# ========================================
RESEND_API_KEY=re_xxxxxxxxxxxx

# Get from: https://resend.com/api-keys

